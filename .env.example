# Copy to .env and fill in. Loaded by pydantic-settings at startup.

# SQLite database location (relative or absolute)
# OPTIONS_TOOL_DB_PATH=data/options.db

# Web panel binding
# OPTIONS_TOOL_WEB_HOST=127.0.0.1
# OPTIONS_TOOL_WEB_PORT=8000

# Telegram (P1+ feature). Leave unset to disable Telegram alerts.
# OPTIONS_TOOL_TELEGRAM_BOT_TOKEN=
# OPTIONS_TOOL_TELEGRAM_CHAT_ID=

# Finnhub — earnings calendar. Free tier (60 req/min) is plenty.
# Get a key at https://finnhub.io/dashboard
# Without this, "DTE excludes earnings" filter is a no-op (no data).
# OPTIONS_TOOL_FINNHUB_API_KEY=
# OPTIONS_TOOL_EARNINGS_LOOKAHEAD_DAYS=120
